              "href": "https://github.com/eecs498-aase/materials/tree/main/labs/Lab02"
            },
            {
              "tag": "Lab03",
              "title": "Where we are, and starting on Aider",
              "href": "https://github.com/eecs498-aase/materials/tree/main/labs/Lab03"
            }
          ]
        },
        {
          "kicker": "推荐来源",
