      "id": "wechat-ai-coding-deepwater",
      "column": "wechat",
      "order": 1,
      "label": "腾讯技术工程",
      "title": "两万字长文｜手把手带你趟过 AI Coding 深水区：编码让位，人退到哪里",
      "href": "wechat/ai-coding-deepwater/index.html",
      "status": "进行中",
      "note": "全文导读 + 5 条主线（57 张卡片）· 变异测试闸门模拟器 · 每条主线一组小测。待：小测 + 复述。",
      "source": "https://mp.weixin.qq.com/s/tSmMdSSzLgTsAX1JUaZI9Q",
      "preview": "wechat/ai-coding-deepwater/preview.png",
      "start": "2026-10-12",
      "cards": 67,
      "threads": [
        {
          "label": "主线 1",
          "title": "提示词的尽头是基础设施",
          "href": "wechat/ai-coding-deepwater/t1-infra.html",
          "cards": 10,
          "range": "第一部分（一）–（五）",
          "conclusion": "提示词只能叮嘱，框架能取消一类错误；判据是事实才做硬门禁"
        },
        {
          "label": "主线 2",
          "title": "编排的尽头是 runtime",
          "href": "wechat/ai-coding-deepwater/t2-runtime.html",
          "cards": 13,
          "range": "第二部分（一）–（五）",
          "conclusion": "skill 补不动残缺的机制；编排追到根上是 runtime 主权问题"
        },
        {
          "label": "主线 3",
          "title": "分数不可信，问题在题集",
          "href": "wechat/ai-coding-deepwater/t3-evals.html",
          "cards": 14,
          "range": "第三部分（一）–（八）",
          "conclusion": "判据必须是执行结果；评测的核心工作是构建题集，不是搭平台"
        },
        {
          "label": "主线 4",
          "title": "人退到决策点",
          "href": "wechat/ai-coding-deepwater/t4-decision.html",
          "cards": 8,
          "range": "第四部分（一）–（三）",
          "conclusion": "有些事实只有机器取得到；会话外的流水线 AI 绕不过"
        },
        {
          "label": "主线 5",
          "title": "把判据变成流程",
          "href": "wechat/ai-coding-deepwater/t5-loops.html",
          "cards": 12,
          "range": "第五部分（一）–（七）",
          "conclusion": "大环套小环，环与环之间只传事实；人是环里的节点"
        }
      ]
    },
